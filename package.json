{
  "name": "@clear-initiative/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing CLEAR's humanitarian data (via clear-api) to AI agents",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "clear-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema.graphql",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/bin.ts",
    "build": "bun run codegen && tsc -p tsconfig.build.json",
    "start": "node dist/bin.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "refresh-schema": "bun scripts/refresh-schema.ts",
    "lint": "eslint .",
    "typecheck": "bun run codegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "graphql": "^16.13.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@types/node": "^25.3.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
