{
  "name": "@clear-initiative/mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server exposing CLEAR's humanitarian data (via clear-api) to AI agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clear",
    "humanitarian",
    "early-warning",
    "situation-analysis"
  ],
  "homepage": "https://github.com/CLEAR-Initiative/clear-mcp#readme",
  "bugs": "https://github.com/CLEAR-Initiative/clear-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CLEAR-Initiative/clear-mcp.git"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "clear-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema.graphql",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/bin.ts",
    "build": "bun run codegen && tsc -p tsconfig.build.json",
    "build:mcpb": "bun run build && bun scripts/build-mcpb.ts",
    "start": "node dist/bin.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "refresh-schema": "bun scripts/refresh-schema.ts",
    "set-version": "bun scripts/set-version.ts",
    "lint": "eslint .",
    "typecheck": "bun run codegen && tsc --noEmit",
    "test": "vitest run --exclude tests/live/**",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "graphql": "^16.13.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@types/node": "^25.3.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
